# Copy this file to .env.local and fill in real values.
# Never commit .env.local — it's already covered by .gitignore.

# Mapbox GL JS PUBLIC access token (required for MapView/DrawMap to
# render). This is a browser-safe public token, not a backend secret —
# it is read directly via import.meta.env.VITE_MAPBOX_ACCESS_TOKEN and is
# never sent to or stored by the FastAPI backend.
# Get one at https://account.mapbox.com/access-tokens/
VITE_MAPBOX_ACCESS_TOKEN=

# Base URL for the FastAPI backend. Defaults to /api if unset.
# Development: http://localhost:8000
# Production:  https://your-render-api.onrender.com
VITE_API_URL=
