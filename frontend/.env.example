# Copy this file to .env.local and fill in real values.
# Never commit .env.local — it's already covered by .gitignore.

# Mapbox GL JS access token (required for MapView to render).
# Get one at https://account.mapbox.com/access-tokens/
VITE_MAPBOX_TOKEN=

# Base URL for the FastAPI backend. Defaults to /api if unset.
# Development: http://localhost:8000
# Production:  https://your-render-api.onrender.com
VITE_API_URL=
