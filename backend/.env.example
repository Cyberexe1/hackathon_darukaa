# Neon PostgreSQL connection string. Use the "psycopg" (v3) driver form:
# postgresql+psycopg://<user>:<password>@<host>/<dbname>?sslmode=require
DATABASE_URL=

# Long, random secret used to sign JWTs. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Comma-separated list of allowed frontend origins for CORS. Never use "*"
# when DEBUG=False. In production, set this to your exact deployed
# frontend origin, e.g. https://your-darukaa-app.vercel.app
CORS_ORIGINS=http://localhost:5173

# Set to False in production. When False, CORS_ORIGINS may not contain "*".
DEBUG=True

# Informational only (surfaced in /health and logs).
ENVIRONMENT=development
